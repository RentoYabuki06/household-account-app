NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- レシート読み取り（サーバー専用。NEXT_PUBLIC_ を付けない） ---
# Google AI Studio で発行した API キー。課金は有効にしないこと（無料枠のみで使う）
GEMINI_API_KEY=
# 使うモデル（省略時は gemini-3.5-flash-lite）
GEMINI_MODEL=gemini-3.5-flash-lite
# 読み取り機能を呼ぶための合言葉。長いランダムな文字列にする（例: openssl rand -base64 24）
RECEIPT_PASSPHRASE=
# 1 日の読み取り回数の上限（省略時は 30）
RECEIPT_DAILY_LIMIT=30
# 回数の記録に使う Supabase の secret key（sb_secret_…）。ブラウザには出ない。GitHub に置かない
SUPABASE_SERVICE_ROLE_KEY=
